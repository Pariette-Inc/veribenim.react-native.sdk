{
  "name": "@veribenim/react-native",
  "version": "1.0.0",
  "description": "Veribenim KVKK/GDPR rıza SDK - React Native (iOS & Android)",
  "keywords": [
    "kvkk",
    "gdpr",
    "consent",
    "veribenim",
    "react-native",
    "ios",
    "android",
    "expo",
    "att"
  ],
  "homepage": "https://veribenim.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pariette-Inc/veribenim.react-native.sdk"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external react --external react-native --external @react-native-async-storage/async-storage",
    "test": "jest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-native": ">=0.68"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.18",
    "jest": "^29.7.0",
    "react": "^19.2.8",
    "react-native": "^0.86.3",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
